{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/volta/browser",
  "rewrites": [
    { "source": "/engine/:path*", "destination": "https://nauti-engine.fly.dev/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
